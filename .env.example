# Public URL used for canonical links, sitemap and Open Graph (build-time)
NEXT_PUBLIC_SITE_URL=https://layeroneconsultants.com

# Host port for docker compose
PORT=3000

# Contact form delivery via SMTP
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave blank to infer from the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Address the mail is sent from (usually the same mailbox as SMTP_USER)
CONTACT_FROM=
CONTACT_TO=contact@layeroneconsultants.com
